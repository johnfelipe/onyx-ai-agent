# URL de tu instancia de Onyx (incluye /api al final)
ONYX_API_URL=https://tu-instancia-onyx.com/api

# API Key de Onyx (para conexión directa sin túnel)
# Se obtiene desde el Admin Panel > Settings > API Keys
ONYX_API_KEY=tu_api_key_aqui

# Credenciales de login de Onyx (solo necesario si usas un túnel con Basic Auth)
ONYX_USERNAME=tu_email@ejemplo.com
ONYX_PASSWORD=tu_password

# Autenticación del túnel (solo si tu instancia está detrás de un túnel con Basic Auth)
TUNNEL_USER=
TUNNEL_PASSWORD=

# Configuración de idioma para consultas multilingües
MULTILINGUAL_QUERY_EXPANSION=Spanish
